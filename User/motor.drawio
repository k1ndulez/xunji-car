        </mxCell>
        <mxCell id="t23-turn" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="turn&lt;br&gt;（转向量）" vertex="1">
          <mxGeometry height="55" width="140" x="780" y="1000" as="geometry"/>
        </mxCell>
        <mxCell id="t23-cmd" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="rpm_cmd&lt;br&gt;（前进速度）" vertex="1">
