                </mxCell>
                <mxCell id="m-note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" value="T_Speed 任务（20 ms）循环：&lt;br&gt;① encoder_rpm() 取实测转速&lt;br&gt;② pid_update(目标, 实测) 算出 duty&lt;br&gt;③ motor_set(duty, 0) 输出&lt;br&gt;注意：duty 与 rpm 方向要一致（正 duty 应得到正 rpm），反了会正反馈。" vertex="1">
                    <mxGeometry height="100" width="620" x="40" y="620" as="geometry"/>
                </mxCell>
                <mxCell id="m-layer" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" value="代码分层：&lt;br&gt;motor.c/h    → motor_set / motor_stop（只碰 TB6612 和 PWM）&lt;br&gt;encoder.c/h  → encoder_rpm（只碰 TIM1 计数）&lt;br&gt;pid.c/h      → pid_update（纯计算，不碰硬件）&lt;br&gt;freertos.c   → T_Speed 任务把三者串起来" vertex="1">
                    <mxGeometry height="110" width="620" x="40" y="740" as="geometry"/>
                </mxCell>        <mxCell id="t23-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1F3864;" value="外环 + 差速混合（循迹 → 左右轮目标）" vertex="1">
          <mxGeometry height="30" width="900" x="40" y="940" as="geometry"/>
        </mxCell>
        <mxCell id="t23-sensor" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="灰度 8 路" vertex="1">
          <mxGeometry height="55" width="140" x="40" y="1000" as="geometry"/>
        </mxCell>
        <mxCell id="t23-read" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="读成 8 bit&lt;br&gt;1 = 黑线" vertex="1">
