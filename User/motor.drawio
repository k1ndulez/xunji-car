        <mxCell id="t23-mixl" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="L = rpm_cmd − turn" vertex="1">
          <mxGeometry height="55" width="200" x="620" y="1090" as="geometry"/>
        </mxCell>
        <mxCell id="t23-mixr" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="R = rpm_cmd + turn" vertex="1">
          <mxGeometry height="55" width="200" x="620" y="1170" as="geometry"/>
