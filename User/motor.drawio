                <mxCell id="m-e8" edge="1" parent="1" source="m-rpm" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" target="m-sum" value="− 实测 rpm">
