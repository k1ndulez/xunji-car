        <mxCell id="t23-gain" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="× Kp（外环 P）" vertex="1">
