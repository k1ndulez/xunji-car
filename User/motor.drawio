        <mxCell id="t23-e5" parent="1" source="t23-cmd" target="t23-mixl" style="html=1;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="+" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t23-e6" parent="1" source="t23-cmd" target="t23-mixr" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" value="+" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t23-e7" parent="1" source="t23-turn" target="t23-mixl" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" value="−" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t23-e8" parent="1" source="t23-turn" target="t23-mixr" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" value="+" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t23-e9" parent="1" source="t23-mixl" target="t23-pidl" style="html=1;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="目标 L" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t23-e10" parent="1" source="t23-mixr" target="t23-pidr" style="html=1;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="目标 R" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t23-e11" parent="1" source="t23-pidl" target="t23-ml" style="html=1;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="duty L" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t23-e12" parent="1" source="t23-pidr" target="t23-mr" style="html=1;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="duty R" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t23-e13" parent="1" source="t23-read" target="t23-lost" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=#FFFFFF;endArrow=classic;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="全白 / 全黑" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t23-note" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" value="偏差公式（8 路）：error = Σ (i − 3.5) × bit_i / Σ bit_i，最左 −3.5、最右 +3.5。&lt;br&gt;外环周期 20~40 ms；先只用 P：turn = Kp × error。&lt;br&gt;左右轮目标 L/R 直接喂给两路速度 PID，就完成了“外环 → 内环”的串联。&lt;br&gt;丢线：记住最后偏差方向、降速直行找线，超时才停车。" vertex="1">
          <mxGeometry height="110" width="960" x="40" y="1270" as="geometry"/>
        </mxCell>      </root>
        </mxGraphModel>
    </diagram>
