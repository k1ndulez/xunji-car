        <mxCell id="t23-ml" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="左电机" vertex="1">
          <mxGeometry height="55" width="90" x="1010" y="1090" as="geometry"/>
        </mxCell>
        <mxCell id="t23-mr" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="右电机" vertex="1">
          <mxGeometry height="55" width="90" x="1010" y="1170" as="geometry"/>
