        <mxCell id="t23-lost" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=12;" value="丢线处理&lt;br&gt;降速找线 / 超时停车" vertex="1">
