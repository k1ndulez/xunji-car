                <mxCell id="m-e1" edge="1" parent="1" source="m-cmd" style="html=1;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="m-sum" value="+">
