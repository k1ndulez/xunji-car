        <mxCell id="t23-e1" parent="1" source="t23-sensor" target="t23-read" style="html=1;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t23-e2" parent="1" source="t23-read" target="t23-err" style="html=1;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="bits" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t23-e3" parent="1" source="t23-err" target="t23-gain" style="html=1;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="error" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
